# app.knocky.ru -> this server (A record in Cloudflare, DNS only).
# Caddy gets the HTTPS certificate automatically.
app.knocky.ru {
	encode gzip
	handle /status {
		root * /opt/knocky/www
		rewrite * /status.html
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8000
	}
	header Strict-Transport-Security "max-age=31536000"
}
